---
// src/components/navbar/navbar.astro
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

// Fetch dynamic brand data for Sukajadi Hotel
import homepageData from "@/content/homepage.json";

// FETCH & NORMALIZE CURRENT PAGE ROUTE
const requestUrlPath = new URL(Astro.request.url).pathname;
const currentPath = requestUrlPath.toLowerCase().replace(/\/$/, "") || "/";

interface MenuItem {
  title: string;
  path: string;
  children?: { title: string; path: string }[];
}

const menuitems: MenuItem[] = [
  { title: "HOME", path: "/" },
  { title: "ROOMS", path: "/rooms" },
  { title: "CULINARY", path: "/food" },
  { title: "TOURIST ATTRACTIONS", path: "/attractions" },
  { title: "GALLERY", path: "/gallery" },
  { title: "MEETINGS & EVENTS", path: "/meetings-events" },
  { title: "Q&A", path: "/qna" }, 
  { title: "CONTACT", path: "/#footer" }, 
];
---

<!-- EXTERNAL ALARIC WIDGET STYLES -->
<link rel="stylesheet" href="https://static.alaric.id/widget2/daterangepicker.min.css" />
<link rel="stylesheet" href="https://static.alaric.id/widget2/style.widget.calendar.css" />

<style is:global>
  .containerrr {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
  }

  /* MATCHING "BOOK NOW" BRAND COLOR (Amber 600 / #d97706) */
  .calcal form .box input[type="submit"] {
    background-color: #d97706 !important;
    border-color: #d97706 !important;
    transition: background-color 0.2s ease-in-out !important;
  }

  .calcal form .box input[type="submit"]:hover {
    background-color: #b45309 !important;
    border-color: #b45309 !important;
  }

  .m-calcal .btn-bottom {
    background-color: #d97706 !important;
    border: 1px solid #d97706 !important;
    transition: background-color 0.2s ease-in-out !important;
  }

  .m-calcal .btn-bottom:hover {
    background-color: #b45309 !important;
    border-color: #b45309 !important;
  }

  .date-picker-wrapper .first-date-selected,
  .date-picker-wrapper .last-date-selected {
    background-color: #d97706 !important;
    color: #fff !important;
  }

  .date-picker-wrapper .month-wrapper table .day.checked {
    background-color: #d97706 !important;
  }
</style>

<header class="sticky top-0 z-40 w-full bg-white shadow-sm transition-all border-b border-gray-100">
  <!-- TOP NAVIGATION BAR -->
  <Container>
    <div class="flex flex-col lg:flex-row justify-between items-center py-4 w-full min-h-[72px] lg:min-h-0">
      <Astronav>
        <div class="flex w-full lg:w-auto items-center justify-between relative">
          <a href="/" class="flex items-center tracking-wider font-serif group">
            {homepageData.logo_image ? (
              <img 
                src={homepageData.logo_image} 
                alt="Sukajadi Hotel & Convention Bandung Logo" 
                class="h-12 md:h-16 w-auto object-contain max-w-[160px] md:max-w-[200px] transition-transform duration-300 group-hover:scale-105" 
              />
            ) : (
              <span class="font-bold text-xl text-slate-900 uppercase">
                {homepageData.logo_text || "Sukajadi"}
              </span>
            )}
          </a>

          <div class="block lg:hidden absolute top-[17px] right-1 z-50 text-slate-950 hover:text-amber-600 transition-colors cursor-pointer p-1">
            <MenuIcon class="w-6 h-6" />
          </div>
        </div>

        <div class="hidden lg:flex flex-col items-center">
          <MenuItems class="hidden w-full lg:w-auto lg:flex relative z-50">
            <ul class="flex flex-col lg:flex-row items-center gap-1 lg:gap-2 w-full justify-center">
              {
                menuitems.map((item, index) => {
                  const itemNormalizedPath = item.path.toLowerCase().replace(/\/$/, "") || "/";
                  const isActive = itemNormalizedPath === "/" 
                    ? currentPath === "/" 
                    : currentPath.startsWith(itemNormalizedPath);

                  return (
                    <>
                      {item.children && (
                        <Dropdown
                          title={item.title}
                          children={item.children}
                          lastItem={index === menuitems.length - 1}
                        />
                      )}

                      {!item.children && (
                        <li class="w-full lg:w-auto">
                          <a
                            href={item.path}
                            class={`nav-item flex lg:px-3 py-2 items-center text-sm font-bold tracking-wide transition-all uppercase relative after:absolute after:bottom-0 after:left-3 after:right-3 after:h-0.5 after:bg-amber-600 after:transition-transform after:duration-300 ${
                              isActive 
                                ? "text-amber-600 after:scale-x-100" 
                                : "text-slate-700 hover:text-amber-600 after:scale-x-0 hover:after:scale-x-100"
                            }`}
                          >
                            <span>{item.title}</span>
                          </a>
                        </li>
                      )}
                    </>
                  );
                })
              }
            </ul>
          </MenuItems>

          <!-- ALARIC BOOKING WIDGET (SUKAJADI HOTEL - SKJH) -->
          <div class="w-full bg-white border-t border-slate-200 pt-3 pb-1 mt-2 notranslate flex justify-center">
            <!-- DESKTOP WIDGET VIEW (CENTERED UNDER NAV LINKS) -->
            <div class="containerrr calcal hidden md:flex justify-center items-center">
              <form action="https://booking.sukajadihotel.com/rates/index" method="post" target="_blank" class="w-full">
                <input type="hidden" name="BookingForm[hotel]" value="SKJH" />
                <input type="hidden" name="BookingForm[utm_source]" value="" />
                <input type="hidden" name="BookingForm[utm_source_session_id]" value="" />
                <input type="hidden" name="BookingForm[checkin]" value="" />
                <input type="hidden" name="BookingForm[checkout]" value="" />
                <input type="hidden" name="BookingForm[adults]" value="2" />
                <input type="hidden" name="BookingForm[uid]" value="" />

                <div class="bx1 flex items-center justify-center gap-6">
                  <!-- EDITABLE DATE RANGE SELECTOR (SPLIT COLUMNS & CENTER-ALIGNED LABELS) -->
                  <div class="box alrc_checkin_checkout cursor-pointer select-none group/box flex items-center gap-2">
                    <object class="alrc-icon" data="https://static.alaric.id/widget2/calendar-outline.svg" width="18" height="18"></object>
                    
                    <div class="flex items-center gap-3">
                      <!-- CHECK-IN COLUMN -->
                      <div class="flex flex-col items-center justify-center text-center">
                        <p class="mb-0.5 text-[10px] font-bold text-slate-600 uppercase tracking-wider text-center group-hover/box:text-amber-600 transition-colors">
                          CHECKIN
                        </p>
                        <span class="alrc_checkin_txt text-xs font-semibold text-slate-900 underline decoration-dotted underline-offset-2">
                          Thu, Sep 16 2026
                        </span>
                      </div>

                      <span class="text-slate-400 font-normal self-end pb-0.5">-</span>

                      <!-- CHECK-OUT COLUMN -->
                      <div class="flex flex-col items-center justify-center text-center">
                        <p class="mb-0.5 text-[10px] font-bold text-slate-600 uppercase tracking-wider text-center group-hover/box:text-amber-600 transition-colors">
                          CHECKOUT
                        </p>
                        <span class="alrc_checkout_txt text-xs font-semibold text-slate-900 underline decoration-dotted underline-offset-2">
                          Thu, Sep 17 2026
                        </span>
                      </div>
                    </div>
                  </div>

                  <!-- EDITABLE GUEST COUNT SELECTOR -->
                  <div class="box relative select-none group/box flex flex-col items-center">
                    <p class="mb-1 text-[10px] font-bold text-slate-600 uppercase tracking-wider text-center group-hover/box:text-amber-600 transition-colors">
                      GUESTS
                    </p>
                    <p class="fs-15 cursor-pointer sh-modal-guest text-xs font-semibold text-slate-900 text-center flex items-center justify-center gap-1.5">
                      <object class="alrc-icon" data="https://static.alaric.id/widget2/people-outline.svg" width="18" height="18"></object>
                      <span class="alrc_val_adult underline decoration-dotted underline-offset-2 font-bold">2</span>
                      <span>Adults</span>
                    </p>

                    <!-- GUEST COUNT EDIT MODAL -->
                    <div class="modal-guest hidden absolute top-full left-1/2 -translate-x-1/2 bg-white border border-slate-200 p-4 rounded-lg shadow-xl z-50 min-w-[220px]">
                      <div class="d-flex mb-2 flex justify-between items-center">
                        <div>
                          <p class="fs-14 font-bold text-xs text-slate-800">Adult(s)</p>
                          <p class="fs-12 text-[10px] text-slate-500">Ages 18 or above</p>
                        </div>
                        <div class="d-flex spinner flex items-center gap-2 border border-slate-300 rounded px-2.5 py-1">
                          <button type="button" class="sub_min alrc_min_adult cursor-pointer font-bold select-none px-1.5 hover:text-amber-600 text-sm">-</button>
                          <span class="spinner_val alrc_val_adult font-bold text-xs">2</span>
                          <button type="button" class="sub_add alrc_add_adult cursor-pointer font-bold select-none px-1.5 hover:text-amber-600 text-sm">+</button>
                        </div>
                      </div>

                      <div class="child-options hidden">
                        <p class="color-grey text-[10px] text-slate-500 mt-2">Information of your children's age will allow us to help you find the best room types suited to your needs.</p>
                        <div class="child-options-data"></div>
                      </div>
                    </div>
                  </div>

                  <!-- EDITABLE PROMO CODE INPUT -->
                  <div class="box flex flex-col items-center">
                    <p class="mb-1 text-[10px] font-bold text-slate-600 uppercase tracking-wider text-center">
                      PROMO CODE
                    </p>
                    <p class="fs-15 text-xs flex items-center justify-center gap-1.5">
                      <object class="alrc-icon" data="https://static.alaric.id/widget2/pricetags-outline.svg" width="18" height="18"></object>
                      <input 
                        type="text" 
                        class="promocode bg-white border border-slate-300 text-xs px-2.5 py-1 rounded focus:outline-none focus:border-amber-600 uppercase text-slate-900 placeholder:text-slate-400 w-32 text-center" 
                        name="BookingForm[offer_code]" 
                        placeholder="ENTER PROMO CODE" 
                      />
                    </p>
                  </div>

                  <!-- SUBMIT BUTTON (MATCHES BRAND AMBER COLOR) -->
                  <div class="box flex items-center">
                    <input 
                      class="fs-15x cursor-pointer px-5 py-2 text-xs font-bold text-white bg-amber-600 hover:bg-amber-700 rounded uppercase shadow-sm transition-colors" 
                      type="submit" 
                      value="Check Availability" 
                    />
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </Astronav>
    </div>

    <!-- MOBILE WIDGET VIEW -->
    <div class="m-calcal block md:hidden w-full border-t border-slate-200 pt-2">
      <div class="floating-btn text-center px-4 py-1">
        <button class="btn-bottom alrc-book-mobile w-full py-2.5 text-xs font-bold text-white bg-amber-600 hover:bg-amber-700 uppercase rounded shadow">
          Book Now
        </button>
      </div>

      <div class="modal-book-alrc hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm p-4 overflow-y-auto">
        <div class="overlay-content max-w-md mx-auto bg-white rounded-xl shadow-2xl p-4 mt-10">
          <div class="content-modal">
            <form action="https://booking.sukajadihotel.com/rates/index" method="post" target="_blank">
              <input type="hidden" name="BookingForm[hotel]" value="SKJH" />
              <input type="hidden" name="BookingForm[utm_source]" value="" />
              <input type="hidden" name="BookingForm[utm_source_session_id]" value="" />
              <input type="hidden" name="BookingForm[checkin]" value="" />
              <input type="hidden" name="BookingForm[checkout]" value="" />
              <input type="hidden" name="BookingForm[adults]" value="2" />
              <input type="hidden" name="BookingForm[uid]" value="" />

              <div class="p-2">
                <div class="head-modal flex justify-between items-center mb-4 border-b pb-2">
                  <h4 class="font-bold text-sm text-slate-800 uppercase">Stay Date</h4>
                  <a href="#" class="btn-close-modal alrc-close-book-mobile text-slate-500 hover:text-slate-900 text-base font-bold">✖</a>
                </div>

                <div class="box-border border p-3 rounded mb-3">
                  <p class="fs-14 mb-2 text-xs font-bold text-slate-700">Checkin - Checkout</p>
                  <div class="flex justify-between text-xs text-slate-600 mb-2">
                    <div>Date</div>
                    <div class="alrc_checkin_checkout_mobile cursor-pointer font-bold text-amber-700">
                      <span class="alrc_checkin_txt">Thu, Sep 16</span> - <span class="alrc_checkout_txt">Fri, Sep 17</span>
                    </div>
                  </div>
                  <div class="m-calcal-mobile w-full"></div>
                </div>

                <div class="box-border border p-3 rounded mb-3">
                  <p class="fs-14 mb-2 text-xs font-bold text-slate-700">Guest</p>
                  <div class="flex justify-between items-center">
                    <div class="text-xs">
                      <p class="font-bold text-slate-800 mb-0">Adult</p>
                      <p class="text-[10px] text-slate-500">Ages 18 or above</p>
                    </div>
                    <div class="spinner flex items-center gap-2 border px-2 py-1 rounded">
                      <button type="button" class="sub_min alrc_min_adult cursor-pointer font-bold px-1.5">-</button>
                      <span class="spinner_val alrc_val_adult text-xs font-bold">2</span>
                      <button type="button" class="sub_add alrc_add_adult cursor-pointer font-bold px-1.5">+</button>
                    </div>
                  </div>
                  <div class="child-options-data"></div>
                </div>

                <div class="box-border border p-3 rounded mb-4">
                  <p class="fs-14 mb-2 text-xs font-bold text-slate-700">Promocode</p>
                  <input type="text" class="promocode w-full border text-xs p-2 rounded focus:outline-none uppercase" placeholder="ENTER PROMO CODE" name="BookingForm[offer_code]" />
                </div>

                <button type="submit" class="btn-bottom w-full py-2.5 text-xs font-bold text-white bg-amber-600 hover:bg-amber-700 uppercase rounded shadow">
                  Check Availability
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </Container>
</header>

<!-- JQUERY, MOMENT.JS & ALARIC WIDGET SCRIPTS -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.16.0/moment.min.js"></script>
<script is:inline src="https://static.alaric.id/widget2/jquery.daterangepicker.js"></script>
<script is:inline src="https://static.alaric.id/widget2/app.alaric.booking.js?v=1.2"></script>

<script is:inline>
  function setupAlaricWidget() {
    if (typeof jQuery === 'undefined' || typeof moment === 'undefined') return;

    var dataPrice = null;

    function formatDate(date) {
      var d = new Date(date),
        month = '' + (d.getMonth() + 1),
        day = '' + d.getDate(),
        year = d.getFullYear();

      if (month.length < 2) month = '0' + month;
      if (day.length < 2) day = '0' + day;

      return [year, month, day].join('-');
    }

    function formatDateDmy(date) {
      var d = new Date(date),
        month = '' + (d.getMonth() + 1),
        day = '' + d.getDate(),
        year = d.getFullYear();

      if (month.length < 2) month = '0' + month;
      if (day.length < 2) day = '0' + day;

      return [day, month, year].join('-');
    }

    function getValueRoomPrice(timestamp) {
      var date_ob = new Date(parseInt(timestamp));
      var ymd = formatDate(date_ob);

      if (dataPrice && dataPrice[ymd]) {
        if (dataPrice[ymd].allotment) {
          return dataPrice[ymd].formatted_price;
        }
        return 'sold';
      }
      return '';
    }

    function getDateFormat(date) {
      var days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

      var dayName = days[date.getDay()];
      var dayMonth = months[date.getMonth()];
      return dayName + ', ' + dayMonth + ' ' + (date.getDate() < 10 ? '0' + date.getDate() : date.getDate()) + ' ' + date.getFullYear();
    }

    var qty_adult = 2;
    var today = new Date();
    var tommorrow = new Date(today.getTime() + 86400000);

    $('.alrc_checkin_txt').html(getDateFormat(today));
    $('.alrc_checkout_txt').html(getDateFormat(tommorrow));

    $("input[name='BookingForm[checkin]']").val(formatDateDmy(today));
    $("input[name='BookingForm[checkout]']").val(formatDateDmy(tommorrow));
    $("input[name='BookingForm[adults]']").val(qty_adult);

    $.ajax({
      url: 'https://webapi-sg.alaric.id/skj/x/calendar/SKJH',
      beforeSend: function (xhr) {
        xhr.setRequestHeader("Authorization", "Basic " + btoa('calendar:g486dJ2wmW'));
      },
      crossDomain: true,
      type: 'GET',
      success: function (data) {
        dataPrice = data;
      }
    });

    $(document).off('click.alaricGuest').on('click.alaricGuest', function (e) {
      if ($(e.target).closest(".box").length === 0) {
        $('.modal-guest').hide();
      }
    });

    $('.sh-modal-guest').off('click').on('click', function (e) {
      $('.modal-guest').toggle();
      e.stopPropagation();
    });

    $('.alrc_add_adult').off('click').on('click', function (e) {
      e.preventDefault();
      qty_adult += 1;
      $('.alrc_val_adult').html(qty_adult);
      $("input[name='BookingForm[adults]']").val(qty_adult);
    });

    $('.alrc_min_adult').off('click').on('click', function (e) {
      e.preventDefault();
      if (qty_adult > 1) {
        qty_adult -= 1;
        $('.alrc_val_adult').html(qty_adult);
        $("input[name='BookingForm[adults]']").val(qty_adult);
      }
    });

    if ($.fn.dateRangePicker) {
      $('.alrc_checkin_checkout').dateRangePicker({
        separator: ' to ',
        container: '.calcal',
        autoClose: true,
        stickyMonths: true,
        selectForward: true,
        startDate: formatDate(new Date()),
        customArrowPrevSymbol: '<span class="alrc-arrow-prev"></span>',
        customArrowNextSymbol: '<span class="alrc-arrow-next"></span>',
        getValue: function () {
          return '';
        },
        setValue: function (s, s1, s2) {
          $('.alrc_checkin_txt').html(getDateFormat(new Date(s1)));
          $('.alrc_checkout_txt').html(getDateFormat(new Date(s2)));

          $("input[name='BookingForm[checkin]']").val(formatDateDmy(new Date(s1)));
          $("input[name='BookingForm[checkout]']").val(formatDateDmy(new Date(s2)));
        }
      }).bind('datepicker-opened', function () {
        var $this = $(this).closest('.calcal').find('.date-picker-wrapper');
        $this.find("td > div.day").each(function () {
          var time = $(this).attr('time');
          if (time) {
            $(this).attr('data-custom', getValueRoomPrice(time));
          }
        });
      });

      $('.alrc_checkin_checkout_mobile').dateRangePicker({
        inline: true,
        container: '.m-calcal-mobile',
        autoClose: true,
        customArrowPrevSymbol: '<span class="alrc-arrow-prev"></span>',
        customArrowNextSymbol: '<span class="alrc-arrow-next"></span>',
        setValue: function (s, s1, s2) {
          $('.alrc_checkin_txt').html(getDateFormat(new Date(s1)));
          $('.alrc_checkout_txt').html(getDateFormat(new Date(s2)));

          $("input[name='BookingForm[checkin]']").val(formatDateDmy(new Date(s1)));
          $("input[name='BookingForm[checkout]']").val(formatDateDmy(new Date(s2)));
        }
      });
    }

    $(".alrc-book-mobile").off('click').on("click", function (e) {
      e.preventDefault();
      $('.modal-book-alrc').removeClass('hidden');
    });

    $(".alrc-close-book-mobile").off('click').on("click", function (e) {
      e.preventDefault();
      $('.modal-book-alrc').addClass('hidden');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAlaricWidget);
  } else {
    setupAlaricWidget();
  }
  document.addEventListener('astro:after-swap', setupAlaricWidget);
</script>