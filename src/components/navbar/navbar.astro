---
// src/components/navbar/navbar.astro
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

// Fetch dynamic brand data for Sukajadi Hotel
import homepageData from "@/content/homepage.json";

// FETCH & NORMALIZE CURRENT PAGE ROUTE
const requestUrlPath = new URL(Astro.request.url).pathname;
const currentPath = requestUrlPath.toLowerCase().replace(/\/$/, "") || "/";

interface MenuItem {
  title: string;
  path: string;
}

const menuitems: MenuItem[] = [
  { title: "HOME", path: "/" },
  { title: "ROOMS", path: "/rooms" },
  { title: "CULINARY", path: "/food" },
  { title: "TOURIST ATTRACTIONS", path: "/attractions" },
  { title: "GALLERY", path: "/gallery" },
  { title: "MEETINGS & EVENTS", path: "/meetings-events" },
  { title: "Q&A", path: "/qna" },
  { title: "CONTACT", path: "/#footer" },
];
---

<!-- EXTERNAL ALARIC WIDGET STYLES -->
<link
  rel="stylesheet"
  href="https://static.alaric.id/widget2/daterangepicker.min.css"
/>
<link
  rel="stylesheet"
  href="https://static.alaric.id/widget2/style.widget.calendar.css"
/>

<style is:global>
  .containerrr {
    width: 100%;
    max-width: 900px;
    margin: auto;
  }

  .calcal form .box input[type="submit"] {
    background: #bf9f62 !important;
    border-color: #bf9f62 !important;
  }

  .m-calcal .btn-bottom {
    background-color: #bf9f62 !important;
    border: 1px solid #bf9f62 !important;
  }

  .date-picker-wrapper .first-date-selected,
  .date-picker-wrapper .last-date-selected {
    background-color: #bf9f62 !important;
    color: #fff !important;
  }

  .date-picker-wrapper .month-wrapper table .day.checked {
    background-color: #bf9f62 !important;
  }
</style>

<header
  class="sticky top-0 z-40 w-full bg-white shadow-sm transition-all border-b border-gray-100">
  <!-- TOP NAVIGATION BAR -->
  <Container>
    <div
      class="flex flex-col lg:flex-row justify-between items-center py-4 w-full min-h-[72px] lg:min-h-0">
      <Astronav>
        <div
          class="flex w-full lg:w-auto items-center justify-between relative">
          <a href="/" class="flex items-center tracking-wider font-serif group">
            {
              homepageData.logo_image ? (
                <img
                  src={homepageData.logo_image}
                  alt="Sukajadi Hotel & Convention Bandung Logo"
                  class="h-12 md:h-16 w-auto object-contain max-w-[160px] md:max-w-[200px] transition-transform duration-300 group-hover:scale-105"
                />
              ) : (
                <span class="font-bold text-xl text-slate-900 uppercase">
                  {homepageData.logo_text || "Sukajadi"}
                </span>
              )
            }
          </a>

          <div
            class="block lg:hidden absolute top-[17px] right-1 z-50 text-slate-950 hover:text-amber-600 transition-colors cursor-pointer p-1">
            <MenuIcon class="w-6 h-6" />
          </div>
        </div>

        <MenuItems
          class="hidden w-full lg:w-auto mt-4 pt-14 lg:pt-0 lg:flex lg:mt-0 relative z-50">
          <ul
            class="flex flex-col lg:flex-row items-start lg:items-center gap-1 lg:gap-2 w-full">
            {
              menuitems.map((item) => {
                const itemNormalizedPath =
                  item.path.toLowerCase().replace(/\/$/, "") || "/";
                const isActive =
                  itemNormalizedPath === "/"
                    ? currentPath === "/"
                    : currentPath.startsWith(itemNormalizedPath);

                return (
                  <li class="w-full lg:w-auto">
                    <a
                      href={item.path}
                      class={`nav-item flex lg:px-3 py-2 items-center text-sm font-bold tracking-wide transition-all uppercase relative after:absolute after:bottom-0 after:left-3 after:right-3 after:h-0.5 after:bg-amber-600 after:transition-transform after:duration-300 ${
                        isActive
                          ? "text-amber-600 after:scale-x-100"
                          : "text-slate-700 hover:text-amber-600 after:scale-x-0 hover:after:scale-x-100"
                      }`}>
                      <span>{item.title}</span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </MenuItems>
      </Astronav>
    </div>
  </Container>

  <!-- ALARIC BOOKING WIDGET (SUKAJADI HOTEL - SKJH) -->
  <div class="w-full bg-slate-50 border-t border-slate-200 py-2.5 notranslate">
    <!-- DESKTOP WIDGET VIEW -->
    <div class="containerrr calcal hidden md:block">
      <form
        action="https://booking.sukajadihotel.com/rates/index"
        method="post"
        target="_blank">
        <input type="hidden" name="BookingForm[hotel]" value="SKJH" />
        <input type="hidden" name="BookingForm[utm_source]" value="" />
        <input
          type="hidden"
          name="BookingForm[utm_source_session_id]"
          value=""
        />
        <input type="hidden" name="BookingForm[checkin]" value="" />
        <input type="hidden" name="BookingForm[checkout]" value="" />
        <input type="hidden" name="BookingForm[adults]" value="2" />
        <input type="hidden" name="BookingForm[uid]" value="" />

        <div class="bx1 flex items-center justify-between gap-3 px-4">
          <div class="box alrc_checkin_checkout cursor-pointer">
            <p class="mb-1 text-[11px] font-bold text-slate-600 uppercase">
              Checkin - Checkout
            </p>
            <p
              class="fs-15 cursor-pointer text-xs font-semibold text-slate-900">
              <span class="d-flex items-center gap-1.5">
                <object
                  class="alrc-icon"
                  data="https://static.alaric.id/widget2/calendar-outline.svg"
                  width="18"
                  height="18"></object>
                <span class="alrc_checkin_txt">Thu Oct 03 2024</span> &nbsp;-&nbsp;
                <span class="alrc_checkout_txt">Thu Oct 03 2024</span>
              </span>
            </p>
          </div>

          <div class="box relative">
            <p class="mb-1 text-[11px] font-bold text-slate-600 uppercase">
              Guests
            </p>
            <p
              class="fs-15 cursor-pointer sh-modal-guest text-xs font-semibold text-slate-900">
              <span class="d-flex items-center gap-1.5">
                <object
                  class="alrc-icon"
                  data="https://static.alaric.id/widget2/people-outline.svg"
                  width="18"
                  height="18"></object>
                <span class="alrc_val_adult">2</span> &nbsp; Adults
              </span>
            </p>

            <div
              class="modal-guest hidden absolute top-full left-0 bg-white border border-slate-200 p-4 rounded-lg shadow-xl z-50 min-w-[220px]">
              <div class="d-flex mb-2 flex justify-between items-center">
                <div>
                  <p class="fs-14 font-bold text-xs text-slate-800">Adult(s)</p>
                  <p class="fs-12 text-[10px] text-slate-500">
                    Ages 18 or above
                  </p>
                </div>
                <div
                  class="d-flex spinner flex items-center gap-2 border border-slate-300 rounded px-2 py-1">
                  <div
                    class="sub_min alrc_min_adult cursor-pointer font-bold select-none px-1">
                    -
                  </div>
                  <div class="spinner_val alrc_val_adult font-bold text-xs">
                    2
                  </div>
                  <div
                    class="sub_add alrc_add_adult cursor-pointer font-bold select-none px-1">
                    +
                  </div>
                </div>
              </div>

              <div class="child-options hidden">
                <p class="color-grey text-[10px] text-slate-500 mt-2">
                  Information of your children's age will allow us to help you
                  find the best room types suited to your needs.
                </p>
                <div class="child-options-data"></div>
              </div>
            </div>
          </div>

          <div class="box">
            <p class="mb-1 text-[11px] font-bold text-slate-600 uppercase">
              Promo code
            </p>
            <p class="fs-15 cursor-pointer">
              <span class="d-flex items-center gap-1.5">
                <object
                  class="alrc-icon"
                  data="https://static.alaric.id/widget2/pricetags-outline.svg"
                  width="18"
                  height="18"></object>
                <input
                  type="text"
                  class="promocode bg-transparent border-b border-slate-300 text-xs px-1 focus:outline-none uppercase"
                  name="BookingForm[offer_code]"
                  placeholder="Enter promo code"
                />
              </span>
            </p>
          </div>

          <div class="box flex-grow-1">
            <input
              class="fs-15x cursor-pointer px-4 py-2 text-xs font-bold text-white rounded uppercase shadow-sm"
              type="submit"
              value="Check Availability"
            />
          </div>
        </div>
      </form>
    </div>

    <!-- MOBILE WIDGET VIEW -->
    <div class="m-calcal block md:hidden">
      <div class="floating-btn text-center px-4 py-1">
        <button
          class="btn-bottom alrc-book-mobile w-full py-2.5 text-xs font-bold text-white uppercase rounded shadow">
          Book Now
        </button>
      </div>

      <div
        class="modal-book-alrc hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm p-4 overflow-y-auto">
        <div
          class="overlay-content max-w-md mx-auto bg-white rounded-xl shadow-2xl p-4 mt-10">
          <div class="content-modal">
            <form
              action="https://booking.sukajadihotel.com/rates/index"
              method="post"
              target="_blank">
              <input type="hidden" name="BookingForm[hotel]" value="SKJH" />
              <input type="hidden" name="BookingForm[utm_source]" value="" />
              <input
                type="hidden"
                name="BookingForm[utm_source_session_id]"
                value=""
              />
              <input type="hidden" name="BookingForm[checkin]" value="" />
              <input type="hidden" name="BookingForm[checkout]" value="" />
              <input type="hidden" name="BookingForm[adults]" value="2" />
              <input type="hidden" name="BookingForm[uid]" value="" />

              <div class="p-2">
                <div
                  class="head-modal flex justify-between items-center mb-4 border-b pb-2">
                  <h4 class="font-bold text-sm text-slate-800 uppercase">
                    Stay Date
                  </h4>
                  <a
                    href="#"
                    class="btn-close-modal alrc-close-book-mobile text-slate-500 hover:text-slate-900 text-base font-bold"
                    >✖</a
                  >
                </div>

                <div class="box-border border p-3 rounded mb-3">
                  <p class="fs-14 mb-2 text-xs font-bold text-slate-700">
                    Checkin - Checkout
                  </p>
                  <div class="flex justify-between text-xs text-slate-600 mb-2">
                    <div>Date</div>
                    <div
                      class="alrc_checkin_checkout_mobile cursor-pointer font-bold text-amber-700">
                      <span class="alrc_checkin_txt">Thu, 03 Oct</span> - <span
                        class="alrc_checkout_txt">Fri, Oct 2024</span
                      >
                    </div>
                  </div>
                  <div class="m-calcal-mobile w-full"></div>
                </div>

                <div class="box-border border p-3 rounded mb-3">
                  <p class="fs-14 mb-2 text-xs font-bold text-slate-700">
                    Guest
                  </p>
                  <div class="flex justify-between items-center">
                    <div class="text-xs">
                      <p class="font-bold text-slate-800 mb-0">Adult</p>
                      <p class="text-[10px] text-slate-500">Ages 18 or above</p>
                    </div>
                    <div
                      class="spinner flex items-center gap-2 border px-2 py-1 rounded">
                      <div
                        class="sub_min alrc_min_adult cursor-pointer font-bold">
                        -
                      </div>
                      <div class="spinner_val alrc_val_adult text-xs font-bold">
                        2
                      </div>
                      <div
                        class="sub_add alrc_add_adult cursor-pointer font-bold">
                        +
                      </div>
                    </div>
                  </div>
                  <div class="child-options-data"></div>
                </div>

                <div class="box-border border p-3 rounded mb-4">
                  <p class="fs-14 mb-2 text-xs font-bold text-slate-700">
                    Promocode
                  </p>
                  <input
                    type="text"
                    class="promocode w-full border text-xs p-2 rounded focus:outline-none uppercase"
                    placeholder="Enter promo code"
                    name="BookingForm[offer_code]"
                  />
                </div>

                <button
                  type="submit"
                  class="btn-bottom w-full py-2.5 text-xs font-bold text-white uppercase rounded shadow">
                  Check Availability
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- JQUERY, MOMENT.JS & ALARIC WIDGET SCRIPTS -->
<script
  is:inline
  src="https://cdnjs.cloudflare.com/ajax/libs/jquery/1.12.4/jquery.min.js"
></script>
<script
  is:inline
  src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.16.0/moment.min.js"
></script>
<script
  is:inline
  src="https://static.alaric.id/widget2/jquery.daterangepicker.js"></script>
<script
  is:inline
  src="https://static.alaric.id/widget2/app.alaric.booking.js?v=1.2"></script>

<script is:inline>
  function setupAlaricWidget() {
    if (typeof jQuery === "undefined" || typeof moment === "undefined") return;

    var dataPrice = null;

    function formatDate(date) {
      var d = new Date(date),
        month = "" + (d.getMonth() + 1),
        day = "" + d.getDate(),
        year = d.getFullYear();

      if (month.length < 2) month = "0" + month;
      if (day.length < 2) day = "0" + day;

      return [year, month, day].join("-");
    }

    function formatDateDmy(date) {
      var d = new Date(date),
        month = "" + (d.getMonth() + 1),
        day = "" + d.getDate(),
        year = d.getFullYear();

      if (month.length < 2) month = "0" + month;
      if (day.length < 2) day = "0" + day;

      return [day, month, year].join("-");
    }

    function getValueRoomPrice(timestamp) {
      var date_ob = new Date(parseInt(timestamp));
      var ymd = formatDate(date_ob);

      if (dataPrice && dataPrice[ymd]) {
        if (dataPrice[ymd].allotment) {
          return dataPrice[ymd].formatted_price;
        }
        return "sold";
      }
      return "";
    }

    function getDateFormat(date) {
      var days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
      var months = [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec",
      ];

      var dayName = days[date.getDay()];
      var dayMonth = months[date.getMonth()];
      return (
        dayName +
        ", " +
        dayMonth +
        " " +
        (date.getDate() < 10 ? "0" + date.getDate() : date.getDate()) +
        " " +
        date.getFullYear()
      );
    }

    var qty_adult = 2;
    var today = new Date();
    var tommorrow = new Date(today.getTime() + 86400000);

    $(".alrc_checkin_txt").html(getDateFormat(today));
    $(".alrc_checkout_txt").html(getDateFormat(tommorrow));

    $("input[name='BookingForm[checkin]']").val(formatDateDmy(today));
    $("input[name='BookingForm[checkout]']").val(formatDateDmy(tommorrow));
    $("input[name='BookingForm[adults]']").val(qty_adult);

    $.ajax({
      url: "https://webapi-sg.alaric.id/skj/x/calendar/SKJH",
      beforeSend: function (xhr) {
        xhr.setRequestHeader(
          "Authorization",
          "Basic " + btoa("calendar:g486dJ2wmW"),
        );
      },
      crossDomain: true,
      type: "GET",
      success: function (data) {
        dataPrice = data;
      },
    });

    $(document)
      .off("click.alaricGuest")
      .on("click.alaricGuest", function (e) {
        if ($(e.target).closest(".box").length === 0) {
          $(".modal-guest").hide();
        }
      });

    $(".sh-modal-guest")
      .off("click")
      .on("click", function (e) {
        $(".modal-guest").toggle();
        e.stopPropagation();
      });

    $(".alrc_add_adult")
      .off("click")
      .on("click", function (e) {
        e.preventDefault();
        qty_adult += 1;
        $(".alrc_val_adult").html(qty_adult);
        $("input[name='BookingForm[adults]']").val(qty_adult);
      });

    $(".alrc_min_adult")
      .off("click")
      .on("click", function (e) {
        e.preventDefault();
        if (qty_adult > 1) {
          qty_adult -= 1;
          $(".alrc_val_adult").html(qty_adult);
          $("input[name='BookingForm[adults]']").val(qty_adult);
        }
      });

    if ($.fn.dateRangePicker) {
      $(".alrc_checkin_checkout")
        .dateRangePicker({
          separator: " to ",
          container: ".calcal",
          autoClose: true,
          stickyMonths: true,
          selectForward: true,
          startDate: formatDate(new Date()),
          customArrowPrevSymbol: '<span class="alrc-arrow-prev"></span>',
          customArrowNextSymbol: '<span class="alrc-arrow-next"></span>',
          getValue: function () {
            return "";
          },
          setValue: function (s, s1, s2) {
            $(".alrc_checkin_txt").html(getDateFormat(new Date(s1)));
            $(".alrc_checkout_txt").html(getDateFormat(new Date(s2)));

            $("input[name='BookingForm[checkin]']").val(
              formatDateDmy(new Date(s1)),
            );
            $("input[name='BookingForm[checkout]']").val(
              formatDateDmy(new Date(s2)),
            );
          },
        })
        .bind("datepicker-opened", function () {
          var $this = $(this).closest(".calcal").find(".date-picker-wrapper");
          $this.find("td > div.day").each(function () {
            var time = $(this).attr("time");
            if (time) {
              $(this).attr("data-custom", getValueRoomPrice(time));
            }
          });
        });

      $(".alrc_checkin_checkout_mobile").dateRangePicker({
        inline: true,
        container: ".m-calcal-mobile",
        autoClose: true,
        customArrowPrevSymbol: '<span class="alrc-arrow-prev"></span>',
        customArrowNextSymbol: '<span class="alrc-arrow-next"></span>',
        setValue: function (s, s1, s2) {
          $(".alrc_checkin_txt").html(getDateFormat(new Date(s1)));
          $(".alrc_checkout_txt").html(getDateFormat(new Date(s2)));

          $("input[name='BookingForm[checkin]']").val(
            formatDateDmy(new Date(s1)),
          );
          $("input[name='BookingForm[checkout]']").val(
            formatDateDmy(new Date(s2)),
          );
        },
      });
    }

    $(".alrc-book-mobile")
      .off("click")
      .on("click", function (e) {
        e.preventDefault();
        $(".modal-book-alrc").removeClass("hidden");
      });

    $(".alrc-close-book-mobile")
      .off("click")
      .on("click", function (e) {
        e.preventDefault();
        $(".modal-book-alrc").addClass("hidden");
      });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupAlaricWidget);
  } else {
    setupAlaricWidget();
  }
  document.addEventListener("astro:after-swap", setupAlaricWidget);
</script>
